# Copy to .env.local and fill in. Read only on the server (in the chat server
# action); none of these reach the browser.

# Unmanaged concierge: the plain Kubernetes Deployment in meridian-demo.
# Locally: kubectl -n meridian-demo port-forward svc/concierge-unmanaged 8000:8000
UNMANAGED_AGENT_URL=http://localhost:8000/chat
# The AGENT_API_KEY in the concierge-unmanaged-api-key Secret.
UNMANAGED_AGENT_API_KEY=

# Managed concierge: the Agent Manager platform-hosted agent. Its chat endpoint
# URL (ending in /chat) and an API key issued for it in Agent Manager.
MANAGED_AGENT_URL=
MANAGED_AGENT_API_KEY=

# Copy to .env.local for `npm run dev`.

# The single demo login (not real authentication; see src/lib/demo-auth.ts).
DEMO_USERNAME=
DEMO_PASSWORD=
# Optional: signs the session cookie. Defaults to DEMO_PASSWORD, so changing
# the password signs everyone out.
DEMO_SESSION_SECRET=

# Moesif management API key for the embedded Canvas dashboard. Give it only
# read access to events: any signed-in visitor can read it in the browser.
MOESIF_CANVAS_KEY=

# Optional: Agent Manager's database, for the "Agent" filter's proxy-to-agent
# mapping. Use a read-only role. Without these the dashboard is unfiltered.
AMP_DB_HOST=
AMP_DB_PORT=5432
AMP_DB_NAME=agentmanager
AMP_DB_USER=
AMP_DB_PASSWORD=
# Set to "handle" if Moesif's apiName carries the proxy handle, not its name.
INSIGHTS_PROXY_MATCH=

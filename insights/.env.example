# Copy to .env.local for `npm run dev`.

# The single demo login (not real authentication; see src/lib/demo-auth.ts).
DEMO_USERNAME=
DEMO_PASSWORD=
# Optional: signs the session cookie. Defaults to DEMO_PASSWORD, so changing
# the password signs everyone out.
DEMO_SESSION_SECRET=

# Moesif management API key for the embedded Canvas dashboard. Give it only
# read access to events: any signed-in visitor can read it in the browser.
MOESIF_CANVAS_KEY=

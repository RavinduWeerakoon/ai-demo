# Unmanaged run (local or docker-compose)
OPENAI_API_KEY=sk-...
AGENT_LABEL=unmanaged
HOTEL_MCP_URL=http://localhost:8090/mcp

# Managed run: set these in Agent Manager instead.
# USE_LLM_PROVIDER=true            (LLM_PROVIDER_URL / LLM_PROVIDER_KEY are injected)
# HOTEL_MCP_URL / HOTEL_MCP_API_KEY  (injected when the Hotel MCP proxy is attached)
# MCP_OAUTH=true                   (uses the injected AMP_AGENTID_* credentials)
# AGENT_LABEL=managed
